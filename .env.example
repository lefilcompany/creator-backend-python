APP_ENV=local
APP_NAME=creator-api
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://creator:creator@db:5432/creator
REDIS_URL=redis://redis:6379/0
AUTH_REQUIRED=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_ALLOWED_JWT_ALGORITHMS=["HS256","RS256"]
SUPABASE_JWKS_CACHE_SECONDS=300
SUPABASE_AUTH_TIMEOUT_SECONDS=5
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TIMEOUT_SECONDS=30
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_INITIAL_DELAY_SECONDS=1
GEMINI_RETRY_MAX_DELAY_SECONDS=8
CREWAI_ENABLED=false
LANGCHAIN_ENABLED=false
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
RAG_VECTOR_STORE_PROVIDER=chroma
RAG_VECTOR_STORE_PATH=.local/rag/chroma
RAG_COLLECTION_NAME=creator-content
RAG_TOP_K=5
GENERATION_QUEUE_NAME=generations
IMAGE_GENERATION_JOB_TIMEOUT_SECONDS=300
IMAGE_GENERATION_JOB_MAX_ATTEMPTS=3
IMAGE_GENERATION_RETRY_INTERVAL_SECONDS=[60,120,240]
IMAGE_GENERATION_STALE_PROCESSING_SECONDS=900
STORAGE_PROVIDER=local
STORAGE_BUCKET=creator-images
STORAGE_MAX_OBJECT_BYTES=10485760
STORAGE_SIGNED_URL_EXPIRES_SECONDS=3600
LOCAL_STORAGE_ROOT=.local/storage
