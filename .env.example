# Runtime
APP_NAME=creator-api
APP_ENV=local
LOG_LEVEL=INFO

# Database
# Use host "db" with docker compose. Use "localhost" when running the API on the host machine.
DATABASE_URL=postgresql+psycopg://creator:creator@db:5432/creator
CREATOR_TEST_DATABASE_URL=postgresql+psycopg://creator:creator@localhost:5432/creator_test

# Queue
REDIS_URL=redis://redis:6379/0

# Auth / Supabase
AUTH_REQUIRED=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_ALLOWED_JWT_ALGORITHMS='["HS256","RS256","RS384","RS512","ES256","ES384","ES512"]'
SUPABASE_AUTH_TIMEOUT_SECONDS=5
SUPABASE_JWKS_CACHE_SECONDS=600

# AI providers
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TIMEOUT_SECONDS=60
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_INITIAL_DELAY_SECONDS=1.0
GEMINI_RETRY_MAX_DELAY_SECONDS=8.0

# Storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=creator-images
STORAGE_SIGNED_URL_EXPIRES_SECONDS=3600
STORAGE_MAX_OBJECT_BYTES=10485760
LOCAL_STORAGE_ROOT=.data/storage
